@model BooksAdmin.Models.Book

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Book</h1>

<h4>Book</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            
            <img class="card-img" alt="Cover of @Model.Title"
                 src="@(Model.UploadedCoverUrl)"
                 onerror="this.onerror=null; this.src='@(Model.CoverImageUrl ?? "https://placehold.co/200x300?text=No+cover")'" />

            <div class="mb-3">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Author" class="control-label"></label>
                <input asp-for="Author" class="form-control" />
                <span asp-validation-for="Author" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GenreId" class="control-label">Genre</label>
                <select asp-for="GenreId" class="form-select" asp-items="ViewBag.GenreId">
                    <option value="" disabled selected hidden>Please select an option</option>
                </select>
                <span asp-validation-for="GenreId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AudienceCategoryId" class="control-label">Audience Category</label>
                <select asp-for="AudienceCategoryId" class="form-select" asp-items="ViewBag.AudienceCategoryId">
                    <option value="" disabled hidden>Please select an option</option>
                </select>
                <span asp-validation-for="AudienceCategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Isbn" class="control-label">ISBN</label>
                <input asp-for="Isbn" class="form-control" />
                <span asp-validation-for="Isbn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="YearPublished" class="control-label">Year Published</label>
                <input asp-for="YearPublished" class="form-control" />
                <span asp-validation-for="YearPublished" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="control-label">Image</label>
                <input accept="image/*" type="file" id="ImageFile" name="ImageFile" class="form-control" />
                @Html.ValidationMessage("ImageFile", new { @class = "text-danger" })
            </div>
            <br />
            <div class="mb-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>


<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
