    <table>
  <thead>
    <tr>
      <th>Cover</th>
      <th>Title</th>
      <th>Author</th>
      <th>Genre</th>
      <th>Year Published</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>
          <img class="card-img"
