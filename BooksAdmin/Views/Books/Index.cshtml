@model IEnumerable<BooksAdmin.Models.Book>

@{
    ViewData["Title"] = "GoodReads";
}

<h1>All Books</h1>

<p>
    <a class = "btn btn-primary" asp-action="Create">Add a book</a>
</p>

<div class="row g-3">
    @foreach (var book in Model)
    {
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100">
                <img class="card-img" alt="Cover of @book.Title"
                     src="@(book.CoverImageUrl ?? "https://placehold.co/200x300?text=No+cover")"
                     onerror="this.onerror=null; this.src='https://placehold.co/200x300?text=No+cover'" />

                <div class="card-body">
                    <h5 class="card-title">@book.Title</h5>
                    <p class="card-text">@book.Author</p>
                    <p class="card-text">@book.Genre</p>
                    <p class="card-text">@book.YearPublished</p>
                </div>
                <div class="card-footer">
                    <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-danger">Delete</a>
                </div>
            </div>
        </div>
    }
</div>