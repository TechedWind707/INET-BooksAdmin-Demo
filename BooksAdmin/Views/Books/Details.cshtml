@using Microsoft.AspNetCore.Html
@model BooksAdmin.Models.Book

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>

    <h4>Book</h4>
    <hr />    
    <dl class="row">
    <dt class="col-sm-2">Cover</dt>
    <dd class="col-sm-10">
        <img style="width: auto; height: 300px; object-fit: cover;" class="card-img" alt="Cover of @Model.Title"
             src="@(Model.UploadedCoverUrl)"
                 onerror="this.onerror=null; this.src='@(Model.CoverImageUrl ?? "https://placehold.co/200x300?text=No+cover")'" />
    </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Author)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Author)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            <p>No Of Reviews</p>
        </dt>
        <dd class = "col-sm-10">
            @Model.BookReviews.Count
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @* @Html.DisplayFor(model => model.Description) *@
            @{
                var descriptionWithBreaks = new HtmlString(Model.Description
                .Replace("\r\n", "<br />")
                .Replace("\n", "<br />")
                .Replace("\r", "<br />"));
            }

           @descriptionWithBreaks
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
           <p>Year Published</p>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.YearPublished)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Isbn)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Isbn)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @* @Html.DisplayNameFor(model => model.Genre.Title) *@
            Genre
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Genre.Title)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @* @Html.DisplayNameFor(model => model.AudienceCategory.Title) *@
            Audience Category
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AudienceCategory.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
    </dl>

</div>
<div class="mb-3">
    <a asp-controller="BookReviews" asp-action="Create" asp-route-bookId="@Model.Id" class="btn btn-primary">Post Review</a>
</div>
<div>
    @if (User.IsInRole("admin"))
    {
        <span>
            <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
        </span>
    }
    <a asp-action="Index">Back to List</a>
</div>
